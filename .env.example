# PostgreSQL connection string for Skill Exchanger backend
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/skillexchanger

# Backend server port (default 5000)
PORT=5000
NODE_ENV=development

# Optional Clerk Authentication Keys (if using real Clerk accounts)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
